      "input": "inputs/r00-malformed.json",
      "structural": true,
      "rationale": "the request carries no 'remaining_hours' and its item has no 'body' -- the guard must fire before any classification happens",
      "expected_output": {
        "status": "INVALID_INPUT",
        "item": null,
        "remaining_hours": null
      }
    },
    {
      "input": "inputs/r01.json",
      "rationale": "stratum owner-open: P1/BUG against {'T1': 'OPEN', 'T2': 'OPEN', 'T3': 'OPEN'} with 20h left",
      "world": {
        "remaining_hours": 20,
        "teams": {
          "T1": "OPEN",
          "T2": "OPEN",
          "T3": "OPEN"
        }
      },
      "expected_sequence": [
        "item=item-041 action=ASSIGN team=T1"
      ],
      "expected_output": {
        "status": "OK",
        "item": {
          "id": "item-041",
          "product": "P1",
          "intent": "BUG",
          "hours": 3,
          "team": "T1",
          "action": "ASSIGN"
        },
        "remaining_hours": 17
