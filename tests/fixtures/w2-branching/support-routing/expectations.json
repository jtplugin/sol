{
  "fixture": "fixture-w2-support-routing",
  "workload_class": "W2",
  "concern": "control-flow fidelity on a single request decided against an injected world state, decomposed into comprehension / conditional fidelity / end-to-end outcome. Routing is set membership, not arithmetic.",
  "min_environment": "E0",
  "oracle": "route_item",
  "catalog": {
    "hours_table": {
      "P1": {
        "BUG": 3,
        "FEATURE": 5,
        "QUESTION": 1
      },
      "P2": {
        "BUG": 2,
        "FEATURE": 4,
        "QUESTION": 1
      },
      "P3": {
        "BUG": 2,
        "FEATURE": 4,
        "QUESTION": 1
      },
      "P4": {
        "BUG": 3,
        "FEATURE": 5,
        "QUESTION": 1
      },
      "P5": {
        "BUG": 3,
        "FEATURE": 5,
        "QUESTION": 1
      }
    },
    "teams": [
      {
        "id": "T1",
        "accepts": [
          "P1",
          "P2"
        ],
        "backs_up": [
          "P3"
        ]
      },
      {
        "id": "T2",
        "accepts": [
          "P3"
        ],
        "backs_up": [
          "P2",
          "P5"
        ]
      },
      {
        "id": "T3",
        "accepts": [
          "P5"
        ],
        "backs_up": []
      }
    ]
  },
